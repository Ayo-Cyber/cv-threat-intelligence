# ── Python ──────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.Python

# ── Build & distribution (PyInstaller output) ────────────────────────────────
dist/
build/
*.dmg
*.app
*.exe
*.AppImage
*.tar.gz
*.zip

# ── Training runs & model outputs ────────────────────────────────────────────
runs/
outputs/

# ── Datasets (large, not for git) ────────────────────────────────────────────
CamNuvem Robbery Dataset/
CamNuvem_Robbery_Dataset/
data/classify/

# ── Model weights (large binaries) ───────────────────────────────────────────
models/*.pt
# Allow placeholder / README inside models/
!models/.gitkeep
!models/README.md
# ...except the weapon checkpoint, which is tracked on purpose: it is small
# enough to ship and a fresh clone has no other way to get it.
!models/weapon_best.pt

# ── IDE & OS ─────────────────────────────────────────────────────────────────
.cursor/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ── External vendored repos (installed separately) ───────────────────────────
external/knife_Gun_Detection/
external/Weapon-Detection-System/

# ── Bundled Ollama binary (fetched at build time by scripts/fetch_ollama.*) ───
vendor/ollama/

# ── Video / media files (large binaries, not for git) ────────────────────────
data/**/*.mp4
data/**/*.mov
data/**/*.avi
data/**/*.mkv
data/**/*.webm
tests/agent_mapper/clips/*
tests/agent_mapper/results/eval_*.csv
# Everything under test_clips, not just video — the eval sets, partial
# downloads and rejected-clip notes that accumulate there are all local.
data/test_clips/*

# ...with these exceptions, which are tracked on purpose. The demo site configs
# point at these nine clips, so a fresh clone without them has nothing to run.
# Negations must come AFTER the patterns above — last match wins.
!data/test_clips/empty_warehouse.mp4
!data/test_clips/normal_street_01.mp4
!data/test_clips/normal_street_02.mp4
!data/test_clips/stabbing_event.mp4
!data/test_clips/theft_shop_01.mp4
!data/test_clips/theft_shop_02.mp4
!data/test_clips/theft_yt_01.mp4
!data/test_clips/violence_suspected.mp4
!data/test_clips/weapons_yt_01.mp4
!tests/agent_mapper/clips/.gitkeep

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
# eval output dir — cvti/training/eval.py writes annotated clips + JSON here
reports/
yolov8s-cls.pt

# ── Large anomaly dataset (CamNuvem robbery clips) — do not commit ────────────
data/anomaly/
data/anomaly-*.zip

# ── Bundled app installers (large binaries) — do not commit ───────────────────
*.dmg
*.exe

# Generated playback-demo bundle (built by packaging/build_demo_data.py)
packaging/demo_data/

# ── Runtime-written configs (per deployment, not source) ─────────────────────
# The app writes a zone + rules file per camera when you draw a zone in-app, and
# resolves live stream URLs into live_camera.json. Those are operator data tied
# to one machine — only the curated defaults we ship are tracked.
configs/live_camera.json
configs/webcam.json
configs/zones/*
configs/rules/*
!configs/zones/live_watch.json
!configs/rules/live_watch.json
!configs/zones/.gitkeep
!configs/rules/.gitkeep

# ── Handoff artifacts (regenerate with git bundle / git format-patch) ────────
argus-work.bundle
argus-patches/
*.bundle

# E2E test artefacts (the container run writes here)
tests/e2e/out/
