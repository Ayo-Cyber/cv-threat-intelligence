{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site_context.schema.json",
  "title": "SiteContext",
  "type": "object",
  "additionalProperties": false,
  "required": ["site_id", "site_type", "site_description", "confidence", "evidence_area_ids", "generated_at"],
  "properties": {
    "site_id": {"type": "string", "minLength": 1},
    "site_type": {"type": "string"},
    "site_description": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_area_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
